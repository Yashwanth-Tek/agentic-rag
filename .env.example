# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# ── Database (this project's own Docker container) ───────────────────────
# Use 127.0.0.1 rather than localhost: on Windows, localhost tries IPv6 first and can stall.
DATABASE_URL=postgresql://agent_user:change-me@127.0.0.1:5434/agentic_rag
# Read by docker-compose to create the container's database; must match DATABASE_URL.
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentic_rag

# ── Embeddings (Ollama, local) ───────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Task prefixes nomic-embed-text expects. Quoted so the trailing space is kept.
OLLAMA_QUERY_PREFIX="search_query: "
OLLAMA_DOCUMENT_PREFIX="search_document: "
EMBEDDING_DIMENSION=768

# ── Claude (backend only; never sent to the browser) ─────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
ANTHROPIC_TIMEOUT_SECONDS=60

# ── Agent limits ─────────────────────────────────────────────────────────
# Executed tool calls per question. The loop is also bounded to MAX_TOOL_CALLS + 1 Claude requests.
MAX_TOOL_CALLS=8
# The agent starts no new retrieval or Claude request after this many seconds.
MAX_AGENT_TIME_SECONDS=90
# Consecutive failed tool calls after which the agent stops and answers from what it has.
MAX_CONSECUTIVE_TOOL_FAILURES=3

# ── Retrieval tools ──────────────────────────────────────────────────────
SEARCH_TOP_K=6
# Chunks scoring below this cosine similarity are never returned to the agent.
# Model-specific: recalibrate whenever the embedding model changes.
SEARCH_MIN_SIMILARITY=0.50
READ_SECTION_MAX_CHARS=8000
READ_MAX_ROWS=60

# ── Ingestion ────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=100
CHUNK_SIZE_CHARS=1500
CHUNK_OVERLAP_CHARS=150
# Unstructured .txt files (and heading-less documents) are stored as parts of about this size.
TEXT_PART_CHARS=4000

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
